<?php

/**
 * Copy this file to secret-local.php (gitignored) and generate your own
 * key - never reuse the example value. Generate one with:
 *   php -r "require 'vendor/autoload.php'; require 'vendor/yiisoft/yii2/Yii.php'; echo (new yii\base\Security())->generateRandomString(32);"
 */
return [
    'cookieValidationKey' => 'CHANGE-ME-generate-a-real-random-key',

    // Online rent payment (PaymentGatewayController) via Flutterwave. Get
    // these from https://dashboard.flutterwave.com/settings/apis - switch
    // the "Test Mode" toggle on first so you get FLWPUBK_TEST-.../
    // FLWSECK_TEST-... keys, not live ones. webhook_hash is a secret string
    // you make up yourself and paste into the same value under
    // Settings > Webhooks in the dashboard - it's how Flutterwave's server
    // proves a webhook call actually came from them.
    // Leave these null to keep online payment disabled (tenants still see
    // "Pay Now" but get a clear "not configured" message instead of it
    // silently failing against fake credentials).
    'flutterwave' => [
        'public_key' => null,
        'secret_key' => null,
        'webhook_hash' => null,
    ],
];
